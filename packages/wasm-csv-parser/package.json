{
  "name": "wasm-csv-parser",
  "version": "0.1.0",
  "description": "Papa Parse-compatible CSV parser. The scanner is Rust, compiled to WebAssembly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "pkg",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./wasm-csv-parser_bg.wasm": "./pkg/wasm-csv-parser_bg.wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/csv-engine --target web --release --out-dir ../../packages/wasm-csv-parser/pkg --out-name wasm-csv-parser",
    "build:js": "tsup",
    "build": "pnpm build:wasm && pnpm build:js",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.8",
    "papaparse": "5.7.0",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
